NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=0
PRE_RELEASE_NOINDEX=false
MONGODB_URI=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Local Vite defaults to http://localhost:5000/api/v1 when unset.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
JWT_ACCESS_SECRET=
JWT_ISSUER=fdfs.one
JWT_AUDIENCE=fdfs-api
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12
APP_WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# FDFS Live reminder worker
LIVE_REMINDER_LEAD_MINUTES=15
LIVE_REMINDER_INTERVAL_MS=60000

# Platform operations
PRESENCE_HEARTBEAT_MS=30000
PRESENCE_STALE_MS=90000
ANALYTICS_ENABLED=true
ANALYTICS_RAW_DAYS=30
ANALYTICS_AGGREGATE_DAYS=365
ANALYTICS_TIMEZONE=Asia/Kolkata
SUPPORT_ATTACHMENTS=true
SUPPORT_ATTACHMENT_DAYS=90
SUPPORT_EMAIL_ATTEMPTS=3
SUPPORT_STAFF_EMAIL=false

# Server-only YouTube Data API key. Leave blank for manual publishing.
YOUTUBE_DATA_API_KEY=
# Public FDFS Live chat is off for this release.
LIVE_CHAT_ENABLED=false
