{
  "name": "fdfs-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace @fdfs/frontend",
    "dev:backend": "npm run dev --workspace @fdfs/backend",
    "build": "npm run build --workspace @fdfs/frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.8.0"
  }
}
