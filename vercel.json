{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/v1/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/assets/:asset*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://fdfs-api-6tvg.onrender.com/api/v1/site/sitemap.xml"
    },
    {
      "source": "/:section(cinema|originals|podcasts|live|reviews|talent)",
      "destination": "/_pages/:section.html"
    },
    {
      "source": "/reviews/:section(movies|short-films|community)",
      "destination": "/_pages/reviews/:section.html"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "https://fdfs-api-6tvg.onrender.com/api/v1/:path*"
    },
    {
      "source": "/:section(cinema|originals|podcasts|live|movies|talent|reviews)/:slug",
      "destination": "/api/public-page?route=/:section/:slug"
    },
    {
      "source": "/((?!api(?:/|$)|socket\\.io(?:/|$)|assets(?:/|$)|_pages(?:/|$)|robots\\.txt$|sitemap\\.xml$).+)",
      "destination": "/_pages/spa.html"
    }
  ]
}
